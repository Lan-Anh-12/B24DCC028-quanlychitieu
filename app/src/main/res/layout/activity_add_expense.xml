<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM KHOẢN CHI"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/edtTenKhoanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên khoản chi"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/edtSoTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số tiền (đ)"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/spDanhMuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày chi tiêu"
            android:paddingTop="12dp" />

        <Button
            android:id="@+id/btnChonNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn ngày" />

        <EditText
            android:id="@+id/edtGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ghi chú (không bắt buộc)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnLuuKhoanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu khoản chi"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>