<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_white_card"
    android:padding="14dp">

    <!-- Biểu tượng danh mục -->
    <TextView
        android:id="@+id/tvBieuTuong"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:background="@drawable/bg_expense_icon"
        android:text="₫"
        android:textColor="@color/primary"
        android:textSize="23sp"
        android:textStyle="bold" />

    <!-- Thông tin khoản chi -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvTenKhoanChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ăn sáng"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDanhMucNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ăn uống | 14/10/2026"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Số tiền -->
    <TextView
        android:id="@+id/tvSoTien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30.000 đ"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>